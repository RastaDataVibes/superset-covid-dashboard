FROM apache/superset:latest

USER root

# Fix mysqlclient pkg-config + build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    default-libmysqlclient-dev \
    libmariadb-dev \
    libmariadb-dev-compat \
    build-essential \
    gcc \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Force gevent via gunicorn extra + drivers (BEFORE apache-superset overrides)
RUN pip install --no-cache-dir gunicorn[gevent]==22.0.0 mysqlclient psycopg2-binary pymysql faker

# Now safe to install your requirements (apache-superset keeps gevent)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy config
COPY superset_config.py /app/pythonpath/superset_config.py

# Monkey-patch for gevent context errors
RUN echo "import gevent.monkey; gevent.monkey.patch_all()" > /tmp/patch.py && \
    cat /tmp/patch.py /app/pythonpath/superset_config.py > /app/pythonpath/temp.py && \
    mv /app/pythonpath/temp.py /app/pythonpath/superset_config.py && \
    rm /tmp/patch.py

USER superset

EXPOSE 8088

# Production gevent CMD
CMD ["gunicorn", "--bind", "0.0.0.0:8088", \
     "--workers", "4", \
     "--worker-class", "gevent", \
     "--worker-connections", "1000", \
     "--timeout", "300", \
     "--keep-alive", "5", \
     "superset.app:create_app()"]
