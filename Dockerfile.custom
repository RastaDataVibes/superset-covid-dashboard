FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# Install gevent + gunicorn FIRST (this is the key)
RUN pip install --no-cache-dir gevent==24.2.1 gunicorn==22.0.0

# Copy requirements and install Superset (gevent already there, no override)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app
COPY . .

# Expose port
EXPOSE 8088

# Production gevent CMD
CMD ["gunicorn", "--bind", "0.0.0.0:8088", "--workers", "2", "--worker-class", "gevent", "--worker-connections", "1000", "--timeout", "300", "superset.app:create_app()"]
